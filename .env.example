# ==============================================================================
# TRAZO ESPACIO GRÁFICO — VARIABLES DE ENTORNO (.env.example)
# Copiá este archivo a .env.local y completá las credenciales reales antes de
# pasar a producción en Vercel. Nunca subas .env.local al repositorio.
# ==============================================================================

# 1. URL PÚBLICA DEL SITIO (Para redirecciones de Mercado Pago, correos y SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 2. SEGURIDAD INTERNA Y ADMINISTRACIÓN
# Clave secreta para firmar sesiones de administrador, enlaces seguros de pedidos
# y URLs temporales de archivos privados (HMAC-SHA256).
APP_SECRET_KEY="cambiar-por-clave-secreta-aleatoria-de-al-menos-32-bytes"

# Credenciales de acceso al Panel Administrador (/admin) cuando no se usa Supabase Auth
ADMIN_EMAIL="Trazoografica@gmail.com"
ADMIN_PASSWORD="cambiar-contraseña-segura-admin"

# 3. SUPABASE (PostgreSQL + Auth + Storage Privado)
# Si estas variables no están definidas en desarrollo, el sistema utiliza
# automáticamente el motor persistente local (data/trazo_db.runtime.json + data/private_storage)
# con la misma estructura relacional y enlaces firmados temporales.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRIVATE_BUCKET="trazo-private-files"

# 4. MERCADO PAGO (Integración Oficial Server-Side)
# Obtener desde https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""

# 5. CORREOS TRANSACCIONALES (Resend / SMTP)
# El sistema NUNCA informa "correo enviado" si el proveedor no está configurado
# y confirmado con respuesta HTTP 200.
RESEND_API_KEY=""
EMAIL_FROM="Trazo Espacio Gráfico <notificaciones@trazografica.com.ar>"
EMAIL_REPLY_TO="Trazoografica@gmail.com"

# 6. RETENCIÓN DE ARCHIVOS PRIVADOS DE CLIENTES
# Días tras la entrega/cancelación para marcar archivos para depuración
FILE_RETENTION_DAYS="90"
